# Copy to .env.compose, chmod 600, and fill locally. Never commit credentials.
QUESTRAG_BIND_ADDRESS=127.0.0.1
QUESTRAG_HTTP_PORT=18080
# Reuse the host's existing services. localhost inside a container is itself.
DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5433/vector_db
REDIS_URL=redis://host.docker.internal:6379/0
VECTOR_BACKEND=milvus
MILVUS_HOST=host.docker.internal
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=questrag_chunks_v2
MILVUS_USER=
MILVUS_PASSWORD=
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=ollama
OPENAI_EMBEDDING_MODEL=bge-m3:latest
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=
# Preserve these values when reusing an existing QuestRAG database.
JWT_SECRET_KEY=
AUTH_ID_NUMBER_PEPPER=
SM2_PRIVATE_KEY=
# Worker inherits the model/key/base URL above unless overridden here.
BROWSER_USE_MODEL=
BROWSER_USE_BASE_URL=
BROWSER_USE_API_KEY=
BROWSER_USE_USE_VISION=false
BROWSER_USE_FORCE_STRUCTURED_OUTPUT=false
# Optional mainland build mirrors; remove to use upstream sources.
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm
UV_IMAGE=ghcr.io/astral-sh/uv:0.9.26
NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.28-alpine
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
NPM_REGISTRY=https://registry.npmmirror.com
