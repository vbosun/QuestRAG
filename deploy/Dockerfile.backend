ARG PYTHON_IMAGE=python:3.12-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.9.26
FROM ${UV_IMAGE} AS uv-source
FROM ${PYTHON_IMAGE}
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG HF_ENDPOINT=https://huggingface.co
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright TOKENIZER_PATH=/opt/questrag-tokenizer
WORKDIR /app
COPY --from=uv-source /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --quiet --frozen --no-dev --no-emit-project --output-file /tmp/requirements.txt \
    && uv pip install --system --require-hashes --index-url "${PIP_INDEX_URL}" -r /tmp/requirements.txt
COPY deploy/tokenizer/ /opt/questrag-tokenizer/
RUN if [ ! -f /opt/questrag-tokenizer/tokenizer.json ]; then HF_ENDPOINT="${HF_ENDPOINT}" python -c "from transformers import AutoTokenizer; AutoTokenizer.from_pretrained('deepseek-ai/DeepSeek-V3', trust_remote_code=False).save_pretrained('/opt/questrag-tokenizer')"; fi \
    && python -c "from transformers import AutoTokenizer; AutoTokenizer.from_pretrained('/opt/questrag-tokenizer', local_files_only=True, trust_remote_code=False)" \
    && chmod -R a+rX /opt/questrag-tokenizer
RUN python -m playwright install --with-deps chromium \
    && chmod -R a+rX /opt/playwright \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 app \
    && mkdir -p /app/logs /app/data && chown -R app:app /app
COPY --chown=app:app quest_rag ./quest_rag
COPY --chown=app:app mock_business_system ./mock_business_system
USER app
EXPOSE 8010
CMD ["python", "-m", "quest_rag.main"]
